<!-- Did not change much this one, that's the layout for the web pages-->
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    
    <title>{{title}}</title>
    
    <!-- import the FomanticUI stylesheet -->
   <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/fomantic-ui@2.9.4/dist/semantic.min.css">
   
     <!-- import the font family that reminds a theatre-->

    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&display=swap" rel="stylesheet">

    <!-- import the webpage's stylesheet -->
    <link rel="stylesheet" href="/style.css">  

    <!-- adding a favicon --> 
    <link rel="icon" type="image/png" href="/images/favicon2.png">
  </head>
  
  <body>
      <div class="page-wrapper">
       {{{body}}}
      </div>

    <!-- import the jQuery file -->
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    
    <!-- import the SemanticUI javascript file -->
    <script src="https://cdn.jsdelivr.net/npm/fomantic-ui@2.9.4/dist/semantic.min.js"></script>
    
    <!-- import the webpage's javascript file -->
    <script src="/script.js"></script>
    
  </body>
</html>
